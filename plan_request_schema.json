{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanRequest",
  "type": "object",
  "properties": {
    "bio_templates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "crit_status_templates": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "$ref": "#/$defs/AgentEnvironment"
    },
    "model_name": {
      "type": "string"
    },
    "system_prompt_override": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "temperature": {
      "$ref": "#/$defs/Temperature",
      "default": 0.2
    }
  },
  "required": [
    "model_name",
    "environment",
    "bio_templates"
  ],
  "$defs": {
    "ActionInfo": {
      "type": "object",
      "properties": {
        "args": {
          "type": "string"
        },
        "desc": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "desc",
        "args",
        "enabled"
      ]
    },
    "AgentEnvironment": {
      "description": "Mirrors C# `AgentEnvironment` in `Robotopia/Assets/Scripts/AgentEnvironment.cs`.\nThe gathered+refined top-level environment sent from the Unity client.",
      "type": "object",
      "properties": {
        "AreaDescriptions": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AreaDesc"
          }
        },
        "POIDescriptions": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/POIDesc"
          }
        },
        "agentFacing": {
          "type": "string",
          "default": ""
        },
        "agentPos": {
          "anyOf": [
            {
              "$ref": "#/$defs/GridCoord"
            },
            {
              "type": "null"
            }
          ]
        },
        "availableActions": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ActionInfo"
          }
        },
        "canWalk": {
          "type": "boolean",
          "default": false
        },
        "critScenePrompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "crits": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/CritData"
          },
          "default": {}
        },
        "currentStatus": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "descriptionTemplate": {
          "type": [
            "string",
            "null"
          ]
        },
        "exampleEntries": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ExampleEntry"
          }
        },
        "facts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Fact"
          }
        },
        "flags": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "heldItemDescriptionTemplate": {
          "type": [
            "string",
            "null"
          ]
        },
        "memos": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/VarValue"
          },
          "default": {}
        },
        "messageStreakCount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "messages": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/AgentMessage"
          }
        },
        "messagesFromCurrentSpeakerCount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "room": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoxDesc"
            },
            {
              "type": "null"
            }
          ]
        },
        "serialNumber": {
          "type": [
            "string",
            "null"
          ]
        },
        "spokenLines": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/SpokenLine"
          }
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/VarValue"
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "AgentMessage": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AgentRole"
        }
      },
      "additionalProperties": false,
      "required": [
        "role",
        "content"
      ]
    },
    "AgentRole": {
      "type": "string",
      "enum": [
        "Speaker",
        "Agent",
        "Echo",
        "Event",
        "Error",
        "Success"
      ]
    },
    "AreaDesc": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "prompt"
      ]
    },
    "BoxDesc": {
      "type": "object",
      "properties": {
        "max": {
          "type": "string"
        },
        "min": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ]
    },
    "CritData": {
      "description": "Mirrors C# CritDataHBS — serialized with lowercase field names",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "failed": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "run": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "passed",
        "failed",
        "run",
        "enabled"
      ]
    },
    "EntityEnvironment": {
      "description": "Minimal environment for entities nested inside VarValue::Env — identity and state only,\nnot what the entity perceives around it (no POIs, facts, messages, crits, etc.).\nMirrors C# `EntityEnvironment` in `Robotopia/Assets/Scripts/AgentEnvironment.cs`.",
      "type": "object",
      "properties": {
        "agentFacing": {
          "type": "string",
          "default": ""
        },
        "agentPos": {
          "anyOf": [
            {
              "$ref": "#/$defs/GridCoord"
            },
            {
              "type": "null"
            }
          ]
        },
        "availableActions": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ActionInfo"
          }
        },
        "canWalk": {
          "type": "boolean",
          "default": false
        },
        "currentStatus": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "descriptionTemplate": {
          "type": [
            "string",
            "null"
          ]
        },
        "flags": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "heldItemDescriptionTemplate": {
          "type": [
            "string",
            "null"
          ]
        },
        "memos": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/VarValue"
          },
          "default": {}
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "serialNumber": {
          "type": [
            "string",
            "null"
          ]
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/VarValue"
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "ExampleEntry": {
      "description": "Mirrors FactMapAsset.Entry — key fact is ignored server-side (used client-side for RAG)",
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/Fact"
        },
        "requiredVars": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "values"
      ]
    },
    "Fact": {
      "description": "Mirrors C# Fact — only content is serialized ([JsonObject(MemberSerialization.OptIn)])",
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "content"
      ]
    },
    "GridCoord": {
      "description": "Coordinate in the game world, serialized by C# as {\"x\": ..., \"z\": ...}",
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "z": {
          "type": "integer",
          "format": "int32"
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "z"
      ]
    },
    "POIDesc": {
      "type": "object",
      "properties": {
        "distance": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pos": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "type": "string"
        },
        "tags": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "prompt",
        "id",
        "distance"
      ]
    },
    "SpokenLine": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "speaker": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "speaker",
        "message"
      ]
    },
    "Temperature": {
      "description": "LLM sampling temperature (0.0 to 2.0, default 0.2)",
      "type": "number",
      "default": 0.2,
      "maximum": 2.0,
      "minimum": 0.0
    },
    "VarValue": {
      "description": "Dynamic BT/Blackboard variable values sent from the Unity client.\nAdjacently tagged: {\"type\": \"Bool\", \"value\": true}. Null has no value field: {\"type\": \"Null\"}.\nTag names match C# EnvVar.Tag enum values exactly.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Number"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Str"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "StrList"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Env"
            },
            "value": {
              "$ref": "#/$defs/EntityEnvironment"
            }
          },
          "required": [
            "type",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Null"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    }
  }
}

